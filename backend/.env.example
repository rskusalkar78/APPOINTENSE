# ===================================================================
# Local Environment Variables for Online Appointment Booking System
# Copy this file to .env or set these environment variables in your OS/IDE.
# DO NOT commit real passwords or production credentials to source control.
# ===================================================================

# Application Server Port
SERVER_PORT=8080

# Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=appointment_booking
DB_USERNAME=root
DB_PASSWORD=your_mysql_root_password_here

# JWT Authentication Secrets
# JWT_SECRET must be a strong random secret key of at least 32 characters (e.g. generated via openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000
