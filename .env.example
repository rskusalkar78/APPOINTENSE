# Root Template Environment Configuration
# Copy this file to .env and configure for local execution

# Spring Boot Backend
SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_NAME=appointment_booking
DB_USERNAME=root
DB_PASSWORD=your_mysql_root_password_here

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000
